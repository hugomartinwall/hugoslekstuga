# Speeds up `docker build` context upload + keeps secrets / dev junk out of
# the image. The Dockerfile already copies only what it needs; this file
# just makes the COPY-into-an-empty-context faster.

.git
.github
.next
.vercel
.cache
.eslintcache
node_modules

# Next app — none of this is used by the munch server.
app
components
hooks
public
docs

# Local logs and env files.
*.log
.env
.env.*

# Editor / OS junk.
.DS_Store
.idea
.vscode

# Markdown — none of these are needed in the image.
*.md
